---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

const locale = 'en';

const facts = [
  { label: 'Company name', value: 'Guangzhou Chuangyuan Mechanical and Electrical Equipment Co., Ltd.' },
  { label: 'Established', value: '2015' },
  { label: 'Location', value: 'Room 304, 305, NO.8 ChiGang North Road, Haizhu District, Guangzhou, Guangdong, China' },
  { label: 'Business scope', value: 'Domestic procurement and import and export trade of high - end electromechanical equipment, valves, meters, communication terminal equipment and electronic automation products' },
  { label: 'Project experience', value: 'Participation in many large-scale projects at home and abroad' },
  { label: 'Customer qualification', value: 'Qualified supplier to central enterprises including CCCC, China Energy Engineering Group and China Railway International' },
];

const credentials = [
  'Ultra Quality and Service Enterprise',
  'AAA level Enterprise Credit Rating',
  'Contract-honoring & Promise-keeping Enterprise',
];
---

<Layout
  title="About Us"
  description="Guangzhou Chuangyuan Mechanical and Electrical Equipment Co., Ltd. was established in 2015 and supplies high-end electromechanical equipment, valves and instrumentation to domestic and overseas projects."
  locale={locale}
  path="about"
>
  <PageHero
    title="A mechanical and electrical equipment supplier built on sourcing discipline"
    lead="Chuang Yuan procures and trades high - end electromechanical equipment, valves, meters, communication terminal equipment and electronic automation products for projects in China and abroad."
  />

  <section class="section">
    <div class="container about-grid">
      <div class="about-copy">
        <h2>Who we are</h2>
        <p>
          Guangzhou Chuangyuan Mechanical and Electrical Equipment Co., Ltd. was established in 2015. We work as a
          high-quality electromechanical equipment supplier, handling domestic procurement together with import and
          export trade for buyers who need equipment sourced to a defined specification.
        </p>
        <p>
          Our work covers high - end electromechanical equipment, valves, meters, communication terminal equipment and
          electronic automation products. We have taken part in many large-scale projects at home and abroad, and we
          are a qualified supplier for well-known central enterprises such as China Communications Construction
          Company (CCCC), China Energy Engineering Group Co., Ltd. and China Railway International Co., Ltd.
        </p>

        <h2>What we hold ourselves to</h2>
        <p>
          Our stated philosophy is that quality changes everything and service achieves the future. In practice that
          means matching each order to a named brand and a defined model, confirming the documentation a project
          requires, and keeping communication with the buyer's technical team direct.
        </p>
        <ul class="credential-list">
          {credentials.map((c) => <li>{c}</li>)}
        </ul>
      </div>

      <aside class="about-facts" aria-labelledby="facts-heading">
        <h2 id="facts-heading">Company at a glance</h2>
        <dl>
          {facts.map((f) => (
            <div class="fact-row">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Need a specification confirmed before you quote?</h2>
        <p>Send us the model, quantity and delivery point, and we will come back with brand options and lead time.</p>
      </div>
      <a href="/en/contact/" class="btn btn-light">Contact Us</a>
    </div>
  </section>
</Layout>

<style>
  :global(.about-grid) {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    align-items: start;
  }

  :global(.about-copy h2) {
    font-size: 1.5rem;
    margin: 0 0 12px;
    color: var(--color-text-dark);
  }

  :global(.about-copy h2:not(:first-child)) {
    margin-top: 32px;
  }

  :global(.about-copy p) {
    color: #4a4a4a;
    line-height: 1.75;
    margin-bottom: 12px;
  }

  :global(.credential-list) {
    margin: 16px 0 0;
    padding-left: 20px;
    color: #4a4a4a;
    line-height: 1.9;
  }

  :global(.about-facts) {
    background: #f5f5f5;
    border: 1px solid rgba(17, 17, 17, 0.07);
    border-radius: 0;
    padding: 28px;
  }

  :global(.about-facts h2) {
    font-size: 1.125rem;
    margin: 0 0 16px;
  }

  :global(.fact-row) {
    padding: 12px 0;
    border-top: 1px solid rgba(17, 17, 17, 0.07);
  }

  :global(.fact-row:first-of-type) {
    border-top: none;
    padding-top: 0;
  }

  :global(.fact-row dt) {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #666666;
    margin-bottom: 4px;
  }

  :global(.fact-row dd) {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-text-dark);
    line-height: 1.6;
  }

  :global(.cta-band) {
    background: #161616;
    color: #ffffff;
    padding: 40px 0;
  }

  :global(.cta-inner) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  :global(.cta-inner h2) {
    font-size: 1.375rem;
    margin: 0 0 6px;
  }

  :global(.cta-inner p) {
    margin: 0;
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    :global(.about-grid) { grid-template-columns: 1fr; gap: 32px; }
    :global(.cta-inner) { flex-direction: column; align-items: flex-start; }
  }
</style>
