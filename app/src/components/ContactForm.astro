---
const { locale, showInfo = true, heading } = Astro.props;

const formLabels = {
  en: {
    name: 'Full Name',
    email: 'Email',
    company: 'Company',
    message: 'Message',
    submit: 'Send Message',
  },
  zh: {
    name: '姓名',
    email: '电子邮件',
    company: '公司名称',
    message: '留言',
    submit: '发送留言',
  },
};

const addr = {
  en: 'Unit B21-7, No.55-21 Xinye Road, Haizhu District, Guangzhou, Guangdong, China',
  zh: '广州市海珠区新业路55号之21-B21-7',
};
---

<section class="contact-section" aria-labelledby="contact-heading">
  <div class={`container contact-inner${showInfo ? '' : ' form-only'}`}>
    {showInfo ? (
      <div class="contact-info">
        <h2 id="contact-heading">{locale === 'zh' ? '联系信息' : 'Contact'}</h2>
        <p>{locale === 'zh' ? '与我们联系' : 'Get in touch'}</p>
        <p><strong>{addr[locale]}</strong></p>
        <p>Mobile: 14749327080</p>
        <p>Email: <a href="mailto:Lucy@chuangyuancorp.com">Lucy@chuangyuancorp.com</a></p>
      </div>
    ) : (
      <h2 id="contact-heading" class="contact-form-heading">{heading ?? (locale === 'zh' ? '在线留言' : 'Send a message')}</h2>
    )}

    <div class="contact-form-wrap">
      <form action="#" method="POST" aria-label="Contact form" class="contact-form">
        <div class="form-group">
          <label for="name">{formLabels[locale].name}</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-group">
          <label for="email">{formLabels[locale].email}</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-group">
          <label for="company">{formLabels[locale].company}</label>
          <input type="text" id="company" name="company" />
        </div>
        <div class="form-group">
          <label for="message">{formLabels[locale].message}</label>
          <textarea id="message" name="message" rows="4" required></textarea>
        </div>
        <button type="submit" class="btn">{formLabels[locale].submit}</button>
      </form>
    </div>
  </div>
</section>

<style>
  :global(.contact-section) {
    background: var(--color-bg-white);
    padding: var(--space-4) 0;
  }

  :global(.contact-inner) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  :global(.contact-info h2) {
    font-size: var(--font-size-h2);
    color: var(--color-text-dark);
    margin-bottom: var(--space-3);
  }

  :global(.contact-info p) {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
    font-size: var(--font-size-sm);
  }

  /* Light section: links must be dark ink. --color-accent is #ffffff,
     which made the email white-on-white and completely invisible. */
  :global(.contact-info a) {
    color: var(--color-text-dark);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.4);
    padding-bottom: 1px;
  }

  :global(.contact-info a:hover) {
    border-bottom-color: var(--color-text-dark);
  }

  :global(.form-group) {
    margin-bottom: var(--space-3);
  }

  :global(.form-group label) {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-dark);
    margin-bottom: var(--space-2);
  }

  :global(.form-group input),
  :global(.form-group textarea) {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-family);
    font-size: var(--font-size-base);
    background: var(--color-bg-white);
  }

  :global(.form-group input:focus),
  :global(.form-group textarea:focus) {
    outline: 2px solid rgba(0, 0, 0, 0.55);
    outline-offset: 2px;
    border-color: transparent;
  }

  :global(.contact-inner.form-only) {
    display: block;
    max-width: 560px;
  }

  :global(.contact-form-heading) {
    font-size: 1.25rem;
    color: var(--color-text-dark);
    margin: 0 0 20px;
  }

  @media (max-width: 768px) {
    :global(.contact-inner) {
      grid-template-columns: 1fr;
    }
  }
</style>
