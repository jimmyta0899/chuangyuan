---
const { locale, showTitle = true } = Astro.props;

/*
 * Every logo below is traceable, recorded in source/images/PROVENANCE.md:
 *  - Schneider / Orbinox / Vertiv / Emerson: the client's own existing site
 *    (chuangyuancorp.com brand wall).
 *  - Samson: Wikimedia Commons file "Samson logo wiki.png".
 *  - Rosemount: Emerson media server, official Rosemount wordmark, recolored
 *    single-tone for light backgrounds.
 *  - Greenwood Crosby: typographic wordmark set locally; this brand is an
 *    Emerson sub-brand (Anderson Greenwood / Crosby) with no standalone public
 *    logo, so it is a wordmark rather than an official mark.
 */
const brands = [
  {
    key: 'schneider',
    name: { en: 'Schneider Electric', zh: '施耐德电气' },
    desc: { en: 'Electrical distribution, automation and energy management', zh: '电气配电、自动化与能源管理' },
    image: '/images/brand-schneider-logo.webp',
    alt: { en: 'Schneider Electric logo', zh: '施耐德电气标志' },
    ratio: [624, 201],
  },
  {
    key: 'orbinox',
    name: { en: 'Orbinox', zh: '欧宾诺斯' },
    desc: { en: 'Industrial valves', zh: '工业阀门' },
    image: '/images/brand-orbinox-logo.webp',
    alt: { en: 'Orbinox logo', zh: '欧宾诺斯标志' },
    ratio: [301, 60],
  },
  {
    key: 'vertiv',
    name: { en: 'Vertiv', zh: '维谛' },
    desc: { en: 'Critical digital infrastructure', zh: '关键数字基础设施' },
    image: '/images/brand-vertiv-logo.webp',
    alt: { en: 'Vertiv logo', zh: '维谛标志' },
    ratio: [666, 466],
  },
  {
    key: 'emerson',
    name: { en: 'Emerson', zh: '艾默生' },
    desc: { en: 'Automation solutions and measurement', zh: '自动化解决方案与测量' },
    image: '/images/brand-emerson-logo.webp',
    alt: { en: 'Emerson logo', zh: '艾默生标志' },
    ratio: [666, 307],
  },
  {
    key: 'samson',
    name: { en: 'Samson', zh: '萨姆森' },
    desc: { en: 'Valves and control equipment', zh: '阀门与控制设备' },
    image: '/images/brand-samson-logo.webp',
    alt: { en: 'Samson logo', zh: '萨姆森标志' },
    ratio: [600, 600],
  },
  {
    key: 'rosemount',
    name: { en: 'Rosemount', zh: '罗斯蒙特' },
    desc: { en: 'Measurement instrumentation', zh: '测量仪表' },
    image: '/images/brand-rosemount-logo.webp',
    alt: { en: 'Rosemount logo', zh: '罗斯蒙特标志' },
    ratio: [666, 94],
  },
  {
    key: 'greenwood',
    name: { en: 'Greenwood Crosby Valves', zh: '格林伍德克罗斯比阀门' },
    desc: { en: 'Pressure relief and safety valves', zh: '泄压与安全阀' },
    image: '/images/brand-greenwood-logo.webp',
    alt: { en: 'Greenwood Crosby Valves wordmark', zh: '格林伍德克罗斯比阀门字标' },
    ratio: [666, 63],
  },
];
---

<section class="brand-grid" aria-labelledby="brands-heading">
  <div class="container">
    {showTitle && (
      <div class="section-title">
        <h2 id="brands-heading">{locale === 'zh' ? '代理品牌' : 'Agent Brands'}</h2>
        <p>{locale === 'zh' ? '我们代理的全球品牌' : 'The global brands we represent'}</p>
      </div>
    )}

    <div class="grid-4 brand-grid-inner">
      {brands.map((brand) => (
        <article class="brand-card">
          <div class="brand-media">
            <img
              src={brand.image}
              alt={brand.alt[locale]}
              width={brand.ratio[0]}
              height={brand.ratio[1]}
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="brand-card-body">
            <h3>{brand.name[locale]}</h3>
            <p>{brand.desc[locale]}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  :global(.brand-grid) {
    background: var(--color-bg-white);
    padding: var(--section-y) 0;
  }

  :global(.brand-card) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--color-bg-white);
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    height: 100%;
  }

  :global(.brand-media) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 104px;
    margin-bottom: var(--space-2);
  }

  :global(.brand-media img) {
    max-width: 88%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  :global(.brand-card-body h3) {
    font-size: var(--font-size-base);
    color: var(--color-text-dark);
    margin-bottom: 4px;
  }

  :global(.brand-card-body p) {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted, #666666);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    :global(.brand-grid-inner) {
      grid-template-columns: 1fr 1fr;
    }
    :global(.brand-media) { height: 84px; }
  }

  @media (max-width: 480px) {
    :global(.brand-grid-inner) {
      grid-template-columns: 1fr;
    }
  }
</style>
