---
const { locale } = Astro.props;

const brands = [
  {
    key: 'schneider',
    name: { en: 'Schneider Electric', zh: '施耐德电气' },
    desc: { en: 'Electrical distribution, automation and energy management', zh: '电气配电、自动化与能源管理' },
    image: '/images/brand-Schneider-1200.webp',
    imageAlt: { en: 'Schneider Electric logo', zh: '施耐德电气标志' },
    hasImage: true,
  },
  {
    key: 'orbinox',
    name: { en: 'Orbinox', zh: '欧宾诺斯' },
    desc: { en: 'Valves', zh: '阀门' },
    image: null,
    imageAlt: null,
    hasImage: false,
  },
  {
    key: 'vertiv',
    name: { en: 'Vertiv', zh: '维谛' },
    desc: { en: 'Critical digital infrastructure', zh: '关键数字基础设施' },
    image: null,
    imageAlt: null,
    hasImage: false,
  },
  {
    key: 'emerson',
    name: { en: 'Emerson', zh: '艾默生' },
    desc: { en: 'Automation solutions and measurement', zh: '自动化解决方案与测量' },
    image: null,
    imageAlt: null,
    hasImage: false,
  },
  {
    key: 'samson',
    name: { en: 'Samson', zh: '萨姆森' },
    desc: { en: 'Valves and control equipment', zh: '阀门与控制设备' },
    image: null,
    imageAlt: null,
    hasImage: false,
  },
  {
    key: 'rosemount',
    name: { en: 'Rosemount', zh: '罗斯蒙特' },
    desc: { en: 'Measurement instrumentation', zh: '测量仪表' },
    image: null,
    imageAlt: null,
    hasImage: false,
  },
  {
    key: 'greenwood',
    name: { en: 'Greenwood Crosby Valves', zh: '格林伍德克罗斯比阀门' },
    desc: { en: 'Industrial valves', zh: '工业阀门' },
    image: null,
    imageAlt: null,
    hasImage: false,
  },
];
---

<section class="brand-grid" aria-labelledby="brands-heading">
  <div class="container">
    <div class="section-title">
      <h2 id="brands-heading">{locale === 'zh' ? '代理品牌' : 'Agent Brands'}</h2>
      <p>{locale === 'zh' ? '我们代理的全球品牌' : 'The global brands we represent'}</p>
    </div>

    <div class="grid-4 brand-grid-inner">
      {brands.map((brand) => (
        <article class={`brand-card ${brand.hasImage ? 'has-image' : 'text-only'}`}>
          <div class="brand-media">
            {brand.hasImage ? (
              <img src={brand.image} alt={brand.imageAlt[locale]} width="1392" height="933" loading="lazy" />
            ) : (
              <span class="brand-wordmark" aria-hidden="true">{brand.name[locale]}</span>
            )}
          </div>
          <div class="brand-card-body">
            <h3>{brand.name[locale]}</h3>
            <p>{brand.desc[locale]}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  :global(.brand-grid) {
    background: var(--color-bg-white);
  }

  :global(.brand-card) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--color-bg-white);
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    height: 100%;
  }

  :global(.brand-media) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 96px;
    margin-bottom: var(--space-2);
  }

  :global(.brand-media img) {
    max-width: 100%;
    max-height: 96px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  :global(.brand-wordmark) {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    min-height: 72px;
    padding: 8px 12px;
    border-radius: 0;
    background: rgba(17, 17, 17, 0.045);
    color: #111111;
    font-size: 1.05rem;
    font-weight: var(--font-weight-bold, 700);
    letter-spacing: 0.01em;
    line-height: 1.25;
  }

  :global(.brand-card-body h3) {
    font-size: var(--font-size-base);
    color: var(--color-text-dark);
    margin-bottom: 4px;
  }

  :global(.brand-card-body p) {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted, #666666);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    :global(.brand-grid-inner) {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    :global(.brand-grid-inner) {
      grid-template-columns: 1fr;
    }
  }
</style>
