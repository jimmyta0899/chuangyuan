---
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

const { src, alt, width, height } = Astro.props;
---

<img src={src} alt={alt} width={width} height={height} />

<style>
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>
