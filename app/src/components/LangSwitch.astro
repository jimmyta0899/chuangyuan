---
const { current } = Astro.props;

const locales = [
  { code: 'en', label: 'EN' },
  { code: 'zh', label: '中文' },
];

// Keep the visitor on the same page when switching language.
// Static build URLs are /zh/... or /en/...; the preview script prefixes them.
const pathMatch = Astro.url.pathname.match(/^\/(?:zh|en)(\/.*)?$/);
const suffix = pathMatch?.[1] && pathMatch[1] !== '/' ? pathMatch[1] : '/';
---

<div class="lang-switch" aria-label="Language switcher">
  {locales.map(({ code, label }) => (
    <a
      class={`lang-btn ${current === code ? 'active' : ''}`}
      href={`/${code}${suffix}`}
      aria-current={current === code ? 'page' : undefined}
    >
      {label}
    </a>
  ))}
</div>

<style>
  :global(.lang-switch) {
    display: inline-flex;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: var(--radius-full);
    padding: 2px;
    background: rgba(255, 255, 255, 0.05);
  }

  :global(.lang-btn) {
    display: inline-block;
    background: transparent;
    border: none;
    color: #ffffff;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    line-height: 1.5;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  :global(.lang-btn:hover) {
    background: rgba(255, 255, 255, 0.1);
  }

  :global(.lang-btn.active) {
    background: #161616; color: #ffffff;
    color: #fff;
  }
</style>

<style>
  :global(.lang-btn) { white-space: nowrap; }
</style>
