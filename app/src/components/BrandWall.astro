---
const { locale } = Astro.props;

const brands = [
  {
    key: 'schneider',
    name: { en: 'Schneider Electric', zh: '施耐德电气' },
    image: '/images/brand-Schneider.jpg',
    imageAlt: { en: 'Schneider Electric logo', zh: '施耐德电气标志' },
    hasImage: true,
  },
  {
    key: 'orbinox',
    name: { en: 'Orbinox', zh: '欧宾诺斯' },
    hasImage: false,
  },
  {
    key: 'vertiv',
    name: { en: 'Vertiv', zh: '维谛' },
    hasImage: false,
  },
  {
    key: 'emerson',
    name: { en: 'Emerson', zh: '艾默生' },
    hasImage: false,
  },
  {
    key: 'samson',
    name: { en: 'Samson', zh: '萨姆森' },
    hasImage: false,
  },
  {
    key: 'rosemount',
    name: { en: 'Rosemount', zh: '罗斯蒙特' },
    hasImage: false,
  },
  {
    key: 'greenwood',
    name: { en: 'Greenwood Crosby Valves', zh: '格林伍德克罗斯比阀门' },
    hasImage: false,
  },
];
---

<section class="brand-wall" aria-labelledby="wall-heading">
  <div class="container">
    <h2 id="wall-heading" class="visually-hidden">{locale === 'zh' ? '品牌墙' : 'Brand Wall'}</h2>
    <div class="wall-grid">
      {brands.map((brand) => (
        <div class="wall-item">
          {brand.hasImage ? (
            <img src={brand.image} alt={brand.imageAlt[locale]} width="1300" height="906" />
          ) : (
            <div class="wall-text brand-wordmark">
              {brand.name[locale]}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  :global(.brand-wall) {
    background: var(--color-bg-white);
    padding: var(--space-4) 0;
  }

  :global(.wall-grid) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    align-items: center;
  }

  :global(.wall-item) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  :global(.wall-item img) {
    max-width: 200px;
    height: auto;
    border-radius: var(--radius-sm);
  }

  :global(.wall-text) {
    font-size: var(--font-size-lg);
    color: var(--color-text-dark);
    font-weight: var(--font-weight-medium);
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (max-width: 768px) {
    :global(.wall-grid) {
      gap: var(--space-2);
    }

    :global(.wall-text) {
      font-size: var(--font-size-base);
      padding: var(--space-2);
    }
  }
</style>
