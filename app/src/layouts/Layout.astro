---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { GA4_MEASUREMENT_ID, GOOGLE_TAG_CONTAINER_ID } from '../config/analytics';

export interface Props {
  title: string;
  description?: string;
  locale?: string;
  path?: string;
}

const { title, description = '', locale = 'en', path = '' } = Astro.props;
const canonicalPath = path ? `/${locale}/${path}/` : `/${locale}/`;
const enPath = path ? `/en/${path}/` : `/en/`;
const zhPath = path ? `/zh/${path}/` : `/zh/`;
const canonicalUrl = `https://www.chuangyuancorp.com${canonicalPath}`;
const enUrl = `https://www.chuangyuancorp.com${enPath}`;
const zhUrl = `https://www.chuangyuancorp.com${zhPath}`;
---

<!DOCTYPE html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en-US'} dir="ltr">
<head>
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_TAG_CONTAINER_ID}`}></script>
  <script is:inline define:vars={{ containerId: GOOGLE_TAG_CONTAINER_ID, measurementId: GA4_MEASUREMENT_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ window.dataLayer.push(arguments); }
    gtag('js', new Date());
    // The GA4 config tag lives inside the Google tag container; the measurement
    // ID is exposed here only for verification and future custom events.
    window.__cyAnalytics = { containerId, measurementId };
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | CHUANG YUAN</title>
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="zh" href={zhUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://www.chuangyuancorp.com/#organization",
    "name": "Guangzhou Chuangyuan Mechanical and Electrical Equipment Co., Ltd.",
    "alternateName": "广州创远机电设备有限公司",
    "url": "https://www.chuangyuancorp.com",
    "logo": "https://www.chuangyuancorp.com/images/logo-nubb.png",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Unit B21-7, No.55-21 Xinye Road, Haizhu District",
      "addressLocality": "Guangzhou",
      "addressRegion": "Guangdong",
      "addressCountry": "CN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "Lucy@chuangyuancorp.com",
      "contactType": "customer service"
    }
  })} />
</head>
<body>
  <Header locale={locale} />
  <main id="main" role="main">
    <slot />
  </main>
  <Footer locale={locale} />

  <!-- Event delegation for the four GA4 custom events. Elements opt in with
       data-cy-event plus optional data-cy-location / data-cy-locale / data-cy-brand. -->
  <script is:inline>
    (function () {
      function pushEvent(name, detail) {
        if (!window.dataLayer || !name) return;
        var payload = { event: name };
        for (var key in detail) {
          if (Object.prototype.hasOwnProperty.call(detail, key)) payload[key] = detail[key];
        }
        window.dataLayer.push(payload);
      }

      function readDetail(element) {
        var detail = {};
        ['location', 'locale', 'brand'].forEach(function (key) {
          var value = element.getAttribute('data-cy-' + key);
          if (value) detail[key] = value;
        });
        return detail;
      }

      document.addEventListener('click', function (event) {
        var target = event.target;
        if (!target || typeof target.closest !== 'function') return;
        var element = target.closest('[data-cy-event]');
        // The submit button sits inside a tagged form; submit handles that event.
        if (!element || element.tagName === 'FORM') return;
        pushEvent(element.getAttribute('data-cy-event'), readDetail(element));
      });

      document.addEventListener('submit', function (event) {
        var form = event.target;
        if (!form || typeof form.getAttribute !== 'function') return;
        var name = form.getAttribute('data-cy-event');
        if (!name) return;
        pushEvent(name, readDetail(form));
      });
    })();
  </script>
</body>
</html>
